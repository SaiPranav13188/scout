# Copy to .env and fill in. See docs/SETUP.md for where each value comes from.
# Never commit .env.

ENV=development                      # "production" on the server

# --- Storage
DATABASE_URL=postgresql+asyncpg://scout:scout@localhost:5432/scout
MONGO_URL=mongodb://localhost:27017  # leave empty to write raw payloads to .devdata/raw (dev only)
MONGO_DB=scout
REDIS_URL=redis://localhost:6379/0

# --- Auth (Supabase). Only OWNER_EMAIL can use the API.
SUPABASE_URL=
OWNER_EMAIL=
# Local development only, lets the dashboard run before Supabase is set up.
# The API refuses to start with this set when ENV=production.
DEV_AUTH_TOKEN=

# --- Encryption key for stored tokens (Fernet). Generate: see docs/SETUP.md
ENCRYPTION_KEY=

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=             # A-Z a-z 0-9 _ - only, 1-256 chars

# --- Aggregators (optional, Phase 2)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Gemini (Phase 3+). Model names are config, never hardcoded.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# --- Misc
HTTP_USER_AGENT=ScoutJobBot/0.1 (personal job search; single user)
CORS_ORIGINS=http://localhost:3000
